{
  "id": "dock",
  "title": "Dock 메뉴 (아래 가운데, 자동 숨김)",
  "suite": "tests/e2e/batchM.e2e.cjs",
  "request": "왼쪽 고정 메뉴를 iOS Dock처럼(아래 가운데, 평소엔 숨김). (추가) 커진 아이콘이 옆 아이콘을 가리지 않게, 마우스가 사라지면 숨게. Today 창 배치는 창 배치 편집 보고서(batchO)로 옮김.",
  "criteria": [
    "왼쪽 메뉴가 없어지고 그 자리를 내용이 쓴다.",
    "Dock은 잠시 뒤 숨고, 마우스가 화면 아래 끝에 오면 아래 가운데에 나타나며, 멀어지면 다시 숨는다.",
    "아이콘에 마우스를 올리면 커지고 \"이름 · 신 이름\"이 뜨며, 누르면 그 화면으로 간다.",
    "커진 아이콘이 옆 아이콘을 가리지 않고, 마우스가 창 밖으로 나가도 숨는다.",
    "휴대폰은 하단 탭 바를 쓰고 Dock이 없다."
  ],
  "date": "2026-11-26",
  "commit": "4f827fa",
  "env": {
    "browser": "Chromium 157.0.8103.78",
    "viewport": "1440×900 (휴대폰 390×844)"
  },
  "checks": [
    {
      "n": 1,
      "name": "왼쪽 메뉴 없음: 화면 왼쪽 끝부터 내용",
      "expected": "제목 x < 40px (예전 왼쪽 메뉴는 184px)",
      "actual": "x = 16px",
      "how": "title.boundingBox().x < 40",
      "pass": true,
      "shot": 1
    },
    {
      "n": 2,
      "name": "Dock은 잠시 뒤 숨는다",
      "expected": "data-shown = 'false'",
      "actual": "'false'",
      "how": "dock.dataset.shown === 'false' (4초 안)",
      "pass": true,
      "shot": 1
    },
    {
      "n": 3,
      "name": "마우스가 아래 끝에 오면 아래 가운데에 나타남",
      "expected": "가운데 x ≈ 720px, 화면 안",
      "actual": "가운데 x = 720px, 아래 888px",
      "how": "|center − 720| < 4 && bottom ≤ 900",
      "pass": true,
      "shot": 2
    },
    {
      "n": 4,
      "name": "아이콘에 마우스를 올리면 커지고 이름이 뜸",
      "expected": "높이 1.2배 이상, \"Timesheets Chronos\"",
      "actual": "48px → 64px, \"Timesheets Chronos\"",
      "how": "after > before × 1.2 && tooltip 에 'Chronos'",
      "pass": true,
      "shot": 2
    },
    {
      "n": 5,
      "name": "커진 아이콘이 옆 아이콘을 가리지 않음",
      "expected": "아이콘끼리 겹침 0px 이하, Dock 높이 그대로",
      "actual": "겹침 최대 -6px, Dock 높이 74 → 74px",
      "how": "앞 아이콘 right − 다음 아이콘 left ≤ 0 && |높이 차| ≤ 1",
      "pass": true,
      "shot": null
    },
    {
      "n": 6,
      "name": "Home · Timesheets · Admin · Settings, 앱 이름과 사용자",
      "expected": "아이콘 4개 + TeamEmbedded",
      "actual": "아이콘 4개 + TeamEmbedded",
      "how": "links === 4 && text 에 'TeamEmbedded'",
      "pass": true,
      "shot": null
    },
    {
      "n": 7,
      "name": "아이콘을 누르면 이동",
      "expected": "/settings",
      "actual": "/settings",
      "how": "pathname === '/settings'",
      "pass": true,
      "shot": null
    },
    {
      "n": 8,
      "name": "마우스가 멀어지면 다시 숨음",
      "expected": "data-shown = 'false'",
      "actual": "'false'",
      "how": "dock.dataset.shown === 'false'",
      "pass": true,
      "shot": null
    },
    {
      "n": 9,
      "name": "마우스가 화면 아래로 빠져나가도 숨음",
      "expected": "아래 끝에서 나타난 뒤 창 밖으로 나가면 data-shown = 'false'",
      "actual": "'false'",
      "how": "창 밖으로 이동 후 3초 안에 dock.dataset.shown === 'false'",
      "pass": true,
      "shot": null
    },
    {
      "n": 10,
      "name": "휴대폰은 하단 탭 바, Dock 없음",
      "expected": "탭 바 보임, Dock 안 보임",
      "actual": "탭 바 보임, Dock 안 보임",
      "how": "!dock.isVisible()",
      "pass": true,
      "shot": 3
    },
    {
      "n": 11,
      "name": "페이지 오류 없음",
      "expected": "0건",
      "actual": "0건",
      "how": "pageerror 수 === 0",
      "pass": true,
      "shot": null
    }
  ],
