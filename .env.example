# ── Frontend (exposed to the browser; never put secrets here) ──
# Leave both empty to run in DEMO mode (data is stored in this browser only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Server only (Vercel → Settings → Environment Variables) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret that Power Automate sends in the "x-teamembedded-token" header to /api/ingest
INGEST_TOKEN=
# Where invite e-mails send people back to (your deployed URL)
APP_URL=https://teamembedded.vercel.app
# Optional: daily background photo from Unsplash (free API key: unsplash.com/developers).
# Without it the app uses random gradient patterns.
UNSPLASH_ACCESS_KEY=
UNSPLASH_QUERY=nature landscape
# Phase 2 (AI mapping suggestions) – not used yet
ANTHROPIC_API_KEY=
